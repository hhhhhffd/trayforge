{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trayforge",
  "version": "1.0.0",
  "identifier": "io.github.hhhhhffd.trayforge",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm --dir ui run dev",
    "beforeBuildCommand": "pnpm --dir ui run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "hhhhhffd",
    "shortDescription": "Developer toolbox in your system tray",
    "longDescription": "Trayforge is an open source Windows tray app with 64 offline developer tools: encoders, hashes, formatters, converters, generators and more.",
    "copyright": "© 2026 hhhhhffd",
    "homepage": "https://github.com/hhhhhffd/trayforge",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
